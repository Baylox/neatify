<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        SpotBugs exclusion filter for Neatify.
        Add exclusions here when a finding is a confirmed false positive.
        Documentation: https://spotbugs.readthedocs.io/en/stable/filter.html
    -->

    <!-- Exclude test helper classes from analysis -->
    <Match>
        <Class name="~io\.neatify\.TestHelper" />
    </Match>

    <!-- Gson DTOs: fields are populated by reflection during deserialization,
         SpotBugs cannot see the writes (UWF_UNWRITTEN_FIELD is a false positive here) -->
    <Match>
        <Class name="~io\.neatify\.cli\.core\.UndoExecutor\$(Legacy.*|RunDoc|MoveDto)" />
        <Bug pattern="UWF_UNWRITTEN_FIELD" />
    </Match>
</FindBugsFilter>
